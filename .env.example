# Copy this file to .env (or .env.local) and fill in your own values.
# Never commit the real .env file — it is already excluded via .gitignore.

NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
OPENAI_API_KEY=your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
NEXT_PUBLIC_GA_MEASUREMENT_ID=your-google-analytics-id-here
NEXT_PUBLIC_ADSENSE_ID=your-adsense-id-here
PERPLEXITY_API_KEY=your-perplexity-api-key-here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key-here

NEXT_PUBLIC_SITE_URL=https://your-deployed-site-url

GROQ_API_KEY=your-groq-api-key-here
COHERE_API_KEY=your-cohere-api-key-here
OPENROUTER_API_KEY=your-openrouter-api-key-here
HUGGINGFACE_API_KEY=your-huggingface-api-key-here
